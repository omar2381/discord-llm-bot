{
  "name": "discord-llm-bot",
  "version": "0.1.0",
  "description": "Discord bot with games, utility, moderation and an optional local-LLM assistant.",
  "author": "Omar Mazhar",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "deploy:commands": "node scripts/deploy-commands.js",
    "deploy:commands:global": "node scripts/deploy-commands.js --global",
    "check:ai": "node scripts/check-ai.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2"
  }
}
