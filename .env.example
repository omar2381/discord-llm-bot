# --- Required ---
DISCORD_TOKEN=
CLIENT_ID=
# Server used for fast command registration during development
DEV_GUILD_ID=

# --- Optional ---
LOG_LEVEL=info
DATABASE_PATH=./data/bot.db
# Your Discord user ID; bypasses AI rate limits
OWNER_ID=

# --- AI (leave OLLAMA_URL empty to disable AI entirely) ---
# e.g. http://localhost:11434, or http://ollama:11434 in docker
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
AI_MAX_HISTORY=12
AI_TIMEOUT_MS=60000
AI_RATE_LIMIT_PER_MIN=5
# Comma-separated channel IDs; empty = all channels
AI_ALLOWED_CHANNEL_IDS=
